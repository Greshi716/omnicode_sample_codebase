# Copy to .env (never commit it).
POSTGRES_USER=library
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=library_db
ANTHROPIC_API_KEY=
# Or use your Claude subscription instead of an API key: run `claude setup-token` on Windows, paste the token here
CLAUDE_CODE_OAUTH_TOKEN=
OMNICODE_SECRET_KEY=change-me
# On-prem model (OpenAI-compatible endpoint, e.g. hosted on your VM). The base URL normally ends in /v1
ONPREM_API_BASE=
ONPREM_API_KEY=
ONPREM_MODEL_NAME=
# Set to 1 to rebuild the symbol index on next container start
OMNICODE_REINDEX=
