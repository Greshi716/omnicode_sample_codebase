{
  "enabledMcpjsonServers": ["omnicode"],
  "permissions": {
    "deny": ["Read", "Write", "Edit", "MultiEdit", "NotebookEdit", "Bash", "Glob", "Grep", "WebFetch", "WebSearch", "Task"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/lending_app/native/tool_policy.py\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/lending_app/native/prompt_policy.py\"" }
        ]
      }
    ]
  }
}